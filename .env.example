# 复制成 .env 后填写。.env 已在 .gitignore 里，永远不会被提交。
# 这个文件本身是给面试官看的 —— 它证明你知道密钥该放哪。

# ---------- Langfuse：只做 trace 存储与可视化，不做评测逻辑 ----------
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# 云端用 https://cloud.langfuse.com ；自部署改成自己的地址
LANGFUSE_HOST=https://cloud.langfuse.com

# ---------- 被测 Agent 用的模型 ----------
# 没有 key 也能跑：adapters/dummy.py 不调用任何模型，tools/smoke.py 走的就是它
MODEL_API_KEY=
MODEL_API_URL=
